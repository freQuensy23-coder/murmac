{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Murmur design tokens. Units: dp for size/spacing/radius, sp for type, ms for duration. Colors are sRGB hex. Source of truth for the Compose theme (see DESIGN.md section 3). Mirrors the CSS custom properties in prototype/index.html.",
  "meta": {
    "version": "0.1.0",
    "date": "2026-11-18",
    "dynamicColor": false,
    "fonts": {
      "sans": { "family": "Onest", "license": "OFL-1.1", "source": "https://fonts.google.com/specimen/Onest", "weights": [400, 500, 600, 700], "subsets": ["latin", "latin-ext", "cyrillic", "cyrillic-ext"], "bundle": "res/font/onest_variable.ttf (variable wght)" },
      "mono": { "family": "JetBrains Mono", "license": "OFL-1.1", "source": "https://fonts.google.com/specimen/JetBrains+Mono", "weights": [400, 500], "subsets": ["latin", "cyrillic"], "usage": "numbers that line up, model specs, timers, the prompt editor" }
    }
  },
  "color": {
    "light": {
      "bg":            { "$type": "color", "$value": "#F6F7F9", "$description": "App background behind grouped surfaces" },
      "surface":       { "$type": "color", "$value": "#FFFFFF", "$description": "Cards, groups, sheets, nav bar, bubble (ready)" },
      "surface2":      { "$type": "color", "$value": "#EEF0F4", "$description": "Search field, segmented track, tonal buttons, audio player" },
      "surface3":      { "$type": "color", "$value": "#E2E5EB", "$description": "Selected list item in inner-display category lists, skeletons, chart bars" },
      "ink":           { "$type": "color", "$value": "#14161B", "$description": "Primary text, active nav pill, icons" },
      "ink2":          { "$type": "color", "$value": "#464C59", "$description": "Secondary text (8.0:1 on bg)" },
      "ink3":          { "$type": "color", "$value": "#6B7280", "$description": "Tertiary text, captions (4.5:1 on bg, 4.8:1 on surface)" },
      "ink4":          { "$type": "color", "$value": "#A3A9B5", "$description": "Decorative only: unplayed waveform, chart secondary series. Never text." },
      "line":          { "$type": "color", "$value": "#E4E7EC", "$description": "Dividers" },
      "line2":         { "$type": "color", "$value": "#D0D4DC", "$description": "Control outlines, chips, radio" },
      "accent":        { "$type": "color", "$value": "#2F4BE8", "$description": "The one accent: primary button, listening bubble, selection, toggles on. White text on it is 6.4:1" },
      "accentPressed": { "$type": "color", "$value": "#2539C4" },
      "onAccent":      { "$type": "color", "$value": "#FFFFFF" },
      "accentSoft":    { "$type": "color", "$value": "#E8ECFF", "$description": "Selected row fill, NPU badge, search highlight" },
      "accentInk":     { "$type": "color", "$value": "#2238C9", "$description": "Accent-colored text on light surfaces (7.2:1 on accentSoft)" },
      "ok":            { "$type": "color", "$value": "#167A49" },
      "okSoft":        { "$type": "color", "$value": "#E3F4EA" },
      "warn":          { "$type": "color", "$value": "#9A5B00" },
      "warnSoft":      { "$type": "color", "$value": "#FFF1D6" },
      "err":           { "$type": "color", "$value": "#C2341F" },
      "errSoft":       { "$type": "color", "$value": "#FDE9E5" },
      "inverse":       { "$type": "color", "$value": "#14161B", "$description": "Snackbar, working bubble (transcribing/polishing), edge tab" },
      "onInverse":     { "$type": "color", "$value": "#F3F4F6" },
      "inverseAccent": { "$type": "color", "$value": "#A9B8FF", "$description": "Action text in snackbars (9.5:1 on inverse)" },
      "scrim":         { "$type": "color", "$value": "#14161B66", "$description": "40% ink under dialogs and sheets" }
    },
    "dark": {
      "bg":            { "$type": "color", "$value": "#0F1013" },
      "surface":       { "$type": "color", "$value": "#17191D" },
      "surface2":      { "$type": "color", "$value": "#1F2227" },
      "surface3":      { "$type": "color", "$value": "#2A2E35" },
      "ink":           { "$type": "color", "$value": "#ECEEF2" },
      "ink2":          { "$type": "color", "$value": "#B9BFCA" },
      "ink3":          { "$type": "color", "$value": "#9AA1AE", "$description": "7.2:1 on bg, 6.6:1 on surface" },
      "ink4":          { "$type": "color", "$value": "#646B78" },
      "line":          { "$type": "color", "$value": "#25282F" },
      "line2":         { "$type": "color", "$value": "#343843" },
      "accent":        { "$type": "color", "$value": "#8296FF", "$description": "Lifted for dark; text on it uses onAccent (6.8:1)" },
      "accentPressed": { "$type": "color", "$value": "#9CABFF" },
      "onAccent":      { "$type": "color", "$value": "#0B1033" },
      "accentSoft":    { "$type": "color", "$value": "#1D2347" },
      "accentInk":     { "$type": "color", "$value": "#B4C1FF" },
      "ok":            { "$type": "color", "$value": "#5FD08F" },
      "okSoft":        { "$type": "color", "$value": "#13261B" },
      "warn":          { "$type": "color", "$value": "#F2B54A" },
      "warnSoft":      { "$type": "color", "$value": "#2B2110" },
      "err":           { "$type": "color", "$value": "#FF8A75" },
      "errSoft":       { "$type": "color", "$value": "#2E1612" },
      "inverse":       { "$type": "color", "$value": "#ECEEF2" },
      "onInverse":     { "$type": "color", "$value": "#14161B" },
      "inverseAccent": { "$type": "color", "$value": "#2F4BE8" },
      "scrim":         { "$type": "color", "$value": "#0000008F" }
    },
    "appTile": {
      "$description": "Fallback letter tiles for host apps when the launcher icon cannot be loaded. Prototype only uses these; the build uses PackageManager icons.",
      "palette": ["#3C7EBF", "#B4473C", "#5E3E63", "#B9861E", "#4F7F52", "#2A2D33", "#3D6E8F", "#3E64B0"]
    }
  },
  "typography": {
    "display":  { "fontFamily": "sans", "fontWeight": 600, "fontSize": 44, "lineHeight": 48, "letterSpacing": -1.2, "use": "Dashboard 'Today' number" },
    "headline": { "fontFamily": "sans", "fontWeight": 600, "fontSize": 28, "lineHeight": 34, "letterSpacing": -0.5, "use": "Screen titles, model name in detail" },
    "onboardingTitle": { "fontFamily": "sans", "fontWeight": 600, "fontSize": 30, "lineHeight": 36, "letterSpacing": -0.6 },
    "title":    { "fontFamily": "sans", "fontWeight": 600, "fontSize": 20, "lineHeight": 26, "letterSpacing": -0.25, "use": "Sheet and dialog titles, empty-state titles" },
    "titleSm":  { "fontFamily": "sans", "fontWeight": 600, "fontSize": 16, "lineHeight": 22, "letterSpacing": -0.1, "use": "Section headings, model names in lists" },
    "topBar":   { "fontFamily": "sans", "fontWeight": 600, "fontSize": 17, "lineHeight": 22, "letterSpacing": 0 },
    "reading":  { "fontFamily": "sans", "fontWeight": 400, "fontSize": 18, "lineHeight": 28, "letterSpacing": -0.1, "use": "History entry detail text" },
    "bodyLg":   { "fontFamily": "sans", "fontWeight": 400, "fontSize": 16, "lineHeight": 24, "letterSpacing": 0 },
    "entry":    { "fontFamily": "sans", "fontWeight": 400, "fontSize": 15, "lineHeight": 22, "letterSpacing": 0, "use": "History list text, 3-line clamp" },
    "rowTitle": { "fontFamily": "sans", "fontWeight": 500, "fontSize": 15, "lineHeight": 20, "letterSpacing": 0 },
    "body":     { "fontFamily": "sans", "fontWeight": 400, "fontSize": 14, "lineHeight": 20, "letterSpacing": 0 },
    "label":    { "fontFamily": "sans", "fontWeight": 500, "fontSize": 14, "lineHeight": 20, "letterSpacing": 0 },
    "button":   { "fontFamily": "sans", "fontWeight": 600, "fontSize": 15, "lineHeight": 20, "letterSpacing": -0.1 },
    "bubble":   { "fontFamily": "sans", "fontWeight": 600, "fontSize": 14, "lineHeight": 18, "letterSpacing": 0 },
    "rowSub":   { "fontFamily": "sans", "fontWeight": 400, "fontSize": 13, "lineHeight": 18, "letterSpacing": 0 },
    "labelSm":  { "fontFamily": "sans", "fontWeight": 500, "fontSize": 12, "lineHeight": 16, "letterSpacing": 0.1, "use": "Nav labels, statuses" },
    "caption":  { "fontFamily": "sans", "fontWeight": 400, "fontSize": 12, "lineHeight": 16, "letterSpacing": 0 },
    "overline": { "fontFamily": "sans", "fontWeight": 600, "fontSize": 11, "lineHeight": 16, "letterSpacing": 0.8, "textTransform": "uppercase" },
    "mono":     { "fontFamily": "mono", "fontWeight": 400, "fontSize": 12, "lineHeight": 16, "letterSpacing": 0, "fontFeatures": "tnum" },
    "monoBadge":{ "fontFamily": "mono", "fontWeight": 500, "fontSize": 11, "lineHeight": 14, "letterSpacing": 0.3 },
    "monoTimer":{ "fontFamily": "mono", "fontWeight": 500, "fontSize": 14, "lineHeight": 18, "letterSpacing": 0, "fontFeatures": "tnum" },
    "editor":   { "fontFamily": "mono", "fontWeight": 400, "fontSize": 13, "lineHeight": 20, "letterSpacing": 0 }
  },
  "spacing": {
    "$description": "4dp grid. Screen gutter is s20 on the cover display and s24/s28 on the inner display.",
    "s2": 2, "s4": 4, "s6": 6, "s8": 8, "s10": 10, "s12": 12, "s14": 14, "s16": 16, "s20": 20, "s24": 24, "s28": 28, "s32": 32, "s40": 40, "s48": 48, "s56": 56
  },
  "radius": {
    "xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 28, "full": 999,
    "$description": "Controls (buttons, chips, search, segmented, bubble) are full. Grouped lists and cards lg. Sheets and dialogs xl. Badges xs. Banners, audio player, editor md."
  },
  "elevation": {
    "e0": { "$description": "Flat. Most of the app.", "shadow": "none" },
    "e1": { "$description": "Cards on bg", "shadow": [{ "y": 1, "blur": 2, "color": "#14161B0F" }, { "y": 1, "blur": 1, "color": "#14161B0A" }] },
    "e2": { "$description": "Bubble, snackbar", "shadow": [{ "y": 2, "blur": 6, "color": "#14161B14" }, { "y": 8, "blur": 24, "color": "#14161B1A" }], "composeShadowElevation": 6 },
    "e3": { "$description": "Bubble while dragged, sheets, dialogs", "shadow": [{ "y": 6, "blur": 16, "color": "#14161B1F" }, { "y": 18, "blur": 40, "color": "#14161B29" }], "composeShadowElevation": 12 }
  },
  "size": {
    "touchTargetMin": 48,
    "iconSm": 16, "icon": 24, "iconLg": 32,
    "iconStroke": 1.75,
    "statusBarPrototype": 36, "gestureBarPrototype": 20,
    "topBar": 56, "screenHeader": 64,
    "bottomNav": 72, "navPill": { "w": 56, "h": 32 },
    "rail": 88,
    "button": 52, "buttonSm": 40, "iconButton": 48, "chip": 32, "segmented": 40, "search": 48,
    "listRowMin": 56, "settingsRowMin": 56,
    "toggle": { "w": 52, "h": 32 }, "radio": 22,
    "progress": 4,
    "bubble": {
      "diameter": 52, "hitArea": 56, "edgeMargin": 8, "aboveFieldGap": 12,
      "listeningWidth": 164, "maxWidth": 280,
      "edgeTab": { "w": 22, "h": 60, "hitW": 48 },
      "cancel": { "diameter": 40, "hitArea": 48, "offsetY": -50 },
      "levelBars": { "count": 7, "width": 3, "gap": 3, "minHeight": 4, "maxHeight": 24 },
      "hideTarget": { "diameter": 64, "bottomInset": 56, "magnetRadius": 72 }
    }
  },
  "layout": {
    "windowSizeClass": { "compactMaxWidth": 599, "mediumMinWidth": 600, "expandedMinWidth": 840, "source": "https://developer.android.com/develop/ui/compose/layouts/adaptive/use-window-size-classes" },
    "fold7Cover": { "px": [1080, 2520], "dpAt420dpi": [411, 960], "sizeClass": "compact width, expanded height", "nav": "bottom bar", "status": "dp values UNVERIFIED on device" },
    "fold7Inner": { "px": [1968, 2184], "dpAt420dpi": [750, 832], "sizeClass": "medium width, medium height (portrait); expanded width in landscape", "nav": "navigation rail", "panes": { "historyList": 300, "modelsList": 316, "settingsCategories": 260 }, "status": "dp values UNVERIFIED on device" }
  },
  "motion": {
    "duration": { "instant": 90, "short": 150, "medium": 240, "long": 360, "extraLong": 500 },
    "easing": {
      "standard":   [0.2, 0.0, 0.0, 1.0],
      "decelerate": [0.05, 0.7, 0.1, 1.0],
      "accelerate": [0.3, 0.0, 0.8, 0.15]
    },
    "spring": {
      "bubbleSnap":   { "stiffness": 400, "dampingRatio": 0.8, "$description": "Release after drag to the nearer edge. 400 = Spring.StiffnessMediumLow" },
      "bubbleMorph":  { "stiffness": 1500, "dampingRatio": 0.9, "$description": "Circle to pill width changes. 1500 = Spring.StiffnessMedium" },
      "bubbleAppear": { "stiffness": 400, "dampingRatio": 0.75, "$description": "Scale 0.6 to 1 plus fade when a field gains focus. 0.75 = Spring.DampingRatioLowBouncy" }
    },
    "bubbleTimings": {
      "tuckAfterIdle": 4000,
      "transcribingLabelDelay": 300,
      "insertedHold": 1200,
      "copiedHold": 4000,
      "errorHold": 6000,
      "levelSampleRate": 30,
      "holdToTalkThreshold": 250,
      "dragSlop": 8
    },
    "reducedMotion": "Replace springs and morphs with 150 ms cross-fades. Level bars show a static 3-step meter."
  }
}
