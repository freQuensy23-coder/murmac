# Single source of truth for the LLM native build. Sourced by build_android.sh, parsed by CMakeLists.txt.
# Bump LLAMA_COMMIT together with LLAMA_TAG; re-run build_android.sh; re-run the host checks in README.md.

# llama.cpp release tag b12520 (2026-11-18), "ggml-cpu : use all threads for large GET_ROWS (#32514)"
LLAMA_TAG="b12520"
LLAMA_COMMIT="ff6b8d176186ce1472a71800fcf3e6b221fcbb7b"
LLAMA_REPO="https://github.com/ggml-org/llama.cpp.git"
# GitHub source archive of LLAMA_COMMIT (used by CMakeLists.txt FetchContent; hash identical on two downloads 2026-11-18)
LLAMA_ARCHIVE_SHA256="ae02c8fc24a3e15abedd3cadcfb9dddb3d32091b9c2f450f65d54dcc90ffdbfa"

# Hexagon SDK 6.7.0.0 "Community Edition", trimmed + repackaged by Qualcomm's snapdragon-toolchain org
# (the same tarball their ghcr.io/snapdragon-toolchain/arm64-android image installs). Public, no login.
HEXAGON_SDK_VERSION="6.7.0.0"
HEXAGON_SDK_URL="https://github.com/snapdragon-toolchain/hexagon-sdk/releases/download/v6.7.0.0/hexagon-sdk-v6.7.0.0-amd64-lnx.tar.xz"
HEXAGON_SDK_SHA256="00725fc449916d7b9af2c2a3c6b54d61f3c872d5dbc1d3ca3fd2f839b1d5dc70"
HEXAGON_TOOLS_VERSION="21.0.04"

# OpenCL headers + ICD loader (Khronos, Apache-2.0) - only to compile/link ggml-opencl for Adreno.
# The loader we build is a link stub; at runtime the vendor /vendor/lib64/libOpenCL.so is used.
OPENCL_REL="2025.07.22"
OPENCL_HEADERS_SHA256="98f0a3ea26b4aec051e533cb1750db2998ab8e82eda97269ed6efe66ec94a240"
OPENCL_CLHPP_SHA256="c1031afde6e9eb042e6fcfbc17078f4b437a7e8d55482a1ca6e0fa762d262a89"
OPENCL_ICD_SHA256="dff7a0b11ad5b63a669358e3476e3dc889a4a361674e5b69b267b944d0794142"

# Local Android toolchain (docs/dev/TOOLCHAIN.md D4)
NDK_VERSION="30.0.16248370"
CMAKE_VERSION="4.1.2"
ANDROID_PLATFORM="android-34"
